# Required for /chat, /voice transcription, and OpenAI TTS fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Optional: ElevenLabs is preferred for TTS when this key is set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional: one distinct voice per Divan council advisor. Defaults are real,
# working ElevenLabs premade voices - override with your own account's IDs.
ELEVENLABS_VOICE_ID_NESREDDIN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_KOROGLU=VR6AewLTigWG4xSOukaG
ELEVENLABS_VOICE_ID_SIMURG=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_NESIMI=ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ID_DEDEQORQUD=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_NIZAMI=TxGEqnHWrfWFTfGW9XjX
# Same idea for the OpenAI TTS fallback path.
OPENAI_TTS_VOICE_NESREDDIN=onyx
OPENAI_TTS_VOICE_KOROGLU=echo
OPENAI_TTS_VOICE_SIMURG=nova
OPENAI_TTS_VOICE_NESIMI=fable
OPENAI_TTS_VOICE_DEDEQORQUD=onyx
OPENAI_TTS_VOICE_NIZAMI=shimmer

# Optional: LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=voice-ai-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: Telegram bot.
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://127.0.0.1:8000

# Memory.
SQLITE_PATH=database/checkpoints.sqlite
MAX_HISTORY_MESSAGES=12

# User feedback (thumbs up/down + corrections). docker-compose.yml points
# this at the same persisted /data volume as SQLITE_PATH in production.
FEEDBACK_PATH=database/feedback.sqlite

# Safety guardrail: shown instead of a council reply when a message signals
# self-harm risk. Default is intentionally generic - override with a real,
# currently-verified local crisis resource before a public deployment.
# CRISIS_RESPONSE_TEXT=

# Abuse protection: in-memory, per-IP rate limits (single process - see
# docker-compose.yml). /chat and /voice share one budget per IP; /feedback
# has its own, separate budget.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_FEEDBACK_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Secondary safety net: OpenAI moderation on incoming messages, alongside
# (not instead of) the self-harm guardrail above. Requires OPENAI_API_KEY;
# fails open (never blocks a message) if that key is missing or the call
# fails for any reason.
MODERATION_ENABLED=true
MODERATION_MODEL=omni-moderation-latest
