      "id": "e5f6a7b8-5555-4e6f-b07b-8c9d0e1f2a3b",
      "name": "Call Voice Resume API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 420]
    },
    {
      "parameters": {
        "jsCode": "// VoiceResponse (app/models/schemas.py) has no `status`/`approval` field\n// the way ChatResponse does - the backend never tells a /voice or\n// /voice/resume caller explicitly that a reply is a pending Koroglu\n// draft. The only stable signal available is that a paused turn always\n// answers with this exact fixed sign-off question (see approval_gate in\n// app/graph/builder.py). This is a best-effort text heuristic, not a real\n// contract field - if that fixed sentence ever changes on the backend,\n// this flag silently stops firing.\nconst body = $json;\nconst HITL_MARKER = 'cəsarətli tövsiyəsidir';\nconst hitlSuspected = typeof body.reply === 'string' && body.reply.includes(HITL_MARKER);\n\nreturn {\n  json: {\n    ...body,\n    segments: Array.isArray(body.segments) ? body.segments : [],\n    hitl_suspected: hitlSuspected,\n    ...(hitlSuspected\n      ? {\n          hitl_note:\n            \"Best-effort heuristic: this looks like a Koroglu approval draft awaiting a human decision, not a finished answer (the /voice response has no explicit status field). POST {thread_id, decision: 'approve'|'reject'|'edit', text?} to /webhook/voice-ai-agent-voice-resume to get the real reply.\",\n        }\n      : {}),\n  },\n};"
      },
      "id": "f6a7b8c9-6666-4f70-9c1d-0e1f2a3b4c5d",
      "name": "Format Voice Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
