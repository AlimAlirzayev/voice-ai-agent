                "operation": "startsWith"
              }
            },
            {
              "id": "cmd-reject",
              "leftValue": "={{ ($json.message?.text || '').trim() }}",
              "rightValue": "/imtina",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            },
            {
              "id": "cmd-edit",
              "leftValue": "={{ ($json.message?.text || '').trim() }}",
              "rightValue": "/duzelis",
              "operator": {
                "type": "string",
                "operation": "startsWith"
