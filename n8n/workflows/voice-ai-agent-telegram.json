    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "=🏛 Bu, Koroğlunun cəsarətli tövsiyəsidir və insan təsdiqini gözləyir (backend `/voice` cavabında ayrıca `status` sahəsi yoxdur - bu bayraq mətn əsaslı best-effort həssaslıqdır).\n\nTəsdiq üçün: /tesdiqle\nİmtina üçün: /imtina\nDəyişdirmək üçün: /duzelis Yeni mətn buraya",
        "additionalFields": {}
      },
      "id": "f3a4b5c6-aaaa-4db4-b051-4c5d6e7f8091",
      "name": "Send HITL Instructions",
