        "operation": "sendVoice",
        "chatId": "={{ $json.chat_id }}",
        "binaryData": true,
        "inputDataFieldName": "data",
        "additionalFields": {
          "caption": "={{ $json.name ? '🏛 ' + $json.name : '' }}"
        }
      },
      "id": "a8c16e0f-02c9-474d-8127-7eb3e8794789",
      "name": "Send Voice Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
