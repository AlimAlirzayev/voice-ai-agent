      "id": "e2f3a4b5-9999-4ca3-af40-3b4c5d6e7f80",
      "name": "Is Last HITL Segment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1900,
        200
