      "typeVersion": 1.2,
      "position": [
        2140,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Voice AI Agent Telegram"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cmd-approve",
              "leftValue": "={{ ($json.message?.text || '').trim() }}",
              "rightValue": "/tesdiqle",
              "operator": {
