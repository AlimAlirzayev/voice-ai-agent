      "id": "a4b5c6d7-bbbb-4ec5-c162-5d6e7f809142",
      "name": "Is Decision Command",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "// Text-command based resolution for a paused Koroglu approval, used\n// instead of Telegram inline-keyboard buttons: this repo's pinned n8n\n// Telegram node version/schema for reply_markup could not be verified\n// against a live instance, so a byte-perfect inline keyboard would be a\n// guess. Plain commands (/tesdiqle, /imtina, /duzelis <text>) use the\n// same well-documented sendMessage/sendVoice nodes already proven\n// elsewhere in this workflow, so the round trip is real and working, not\n// just documented.\nconst text = ($json.message.text || '').trim();\nconst lower = text.toLowerCase();\nconst chatId = $json.message.chat.id;\n\nlet decision = 'approve';\nlet extra = '';\nif (lower.startsWith('/imtina')) {\n  decision = 'reject';\n} else if (lower.startsWith('/duzelis')) {\n  decision = 'edit';\n  const spaceIdx = text.indexOf(' ');\n  extra = spaceIdx === -1 ? '' : text.slice(spaceIdx + 1).trim();\n}\n\nreturn {\n  json: {\n    thread_id: 'tg-' + chatId,\n    chat_id: chatId,\n    decision,\n    text: extra,\n  },\n};"
      },
      "id": "b5c6d7e8-cccc-4fd6-d273-6e7f80914253",
      "name": "Parse Decision Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        640
      ]
    },
