      "id": "b8c9d0e1-8888-4b92-9e3f-2a3b4c5d6e7f",
      "name": "Send Transcript",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1180,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Voice AI Agent Telegram"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn one backend reply (/voice or /voice/resume) into one item per\n// spoken segment, matching bot.py's _send_voice_segments: one Telegram\n// voice note per council member who actually spoke, captioned with their\n// name, in speaking order.\n//\n// HITL caveat: VoiceResponse (app/models/schemas.py) has no `status` /\n// `approval` field the way ChatResponse does, so this workflow cannot\n// know for certain that a reply is a paused Koroglu draft awaiting\n// approval. The only stable signal left is that approval_gate() in\n// app/graph/builder.py always answers with this exact fixed question\n// while paused - a best-effort heuristic, not a real contract field.\nconst body = $input.first().json;\nconst chatId = $('Telegram Voice Trigger').first().json.message.chat.id;\nconst threadId = 'tg-' + chatId;\n\nconst HITL_MARKER = 'cəsarətli tövsiyəsidir';\nconst hitlSuspected = typeof body.reply === 'string' && body.reply.includes(HITL_MARKER);\n\nconst segments = Array.isArray(body.segments) && body.segments.length\n  ? body.segments\n  : [{ name: 'Divan', advisor: '', audio_base64: body.audio_base64, audio_mime: body.audio_mime }];\n\nconst items = [];\nfor (let i = 0; i < segments.length; i++) {\n  const segment = segments[i];\n  const audio = Buffer.from(segment.audio_base64, 'base64');\n  items.push({\n    json: {\n      chat_id: chatId,\n      thread_id: threadId,\n      turn_id: body.turn_id || '',\n      name: segment.name || '',\n      is_last: i === segments.length - 1,\n      hitl_suspected: hitlSuspected,\n    },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        audio,\n        `voice-ai-reply-${i}.ogg`,\n        segment.audio_mime || 'audio/ogg',\n      ),\n    },\n  });\n}\n\nreturn items;"
      },
      "id": "d1e1b6e1-2b3a-4825-b117-f33781e41f7d",
      "name": "Prepare Voice Segments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        200
      ]
    },
    {
      "parameters": {
