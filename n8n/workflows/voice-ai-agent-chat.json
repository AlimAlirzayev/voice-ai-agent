      "id": "b2d3f4a5-2222-4b3c-8d4e-5f6a7b8c9d0e",
      "name": "Call Chat Resume API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// ChatResponse (unlike VoiceResponse) already carries `status` and\n// `approval` from the backend (see app/models/schemas.py), so this is a\n// straight pass-through - we only add a short, explicit hint so a caller\n// that ignores `status` doesn't mistake the approval question for the\n// final answer.\nconst body = $json;\n\nif (body.status === 'pending_approval') {\n  return {\n    json: {\n      ...body,\n      resume_hint: \"This is a draft awaiting human sign-off (Koroglu spoke), not the final answer. POST {thread_id, decision: 'approve'|'reject'|'edit', text?} to /webhook/voice-ai-agent-chat-resume to get the real reply.\",\n    },\n  };\n}\n\nreturn { json: body };"
      },
      "id": "c3e4f5a6-3333-4c4d-9e5f-6a7b8c9d0e1f",
      "name": "Format Chat Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "48b6c41b-fbe7-48e2-99fb-68a9ccf0a9f1",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
